'use client';

  import { useEffect, useMemo, useRef, useState } from 'react';
  import { usePathname, useSearchParams } from 'next/navigation';

  declare global {
    interface Window {
      gtag?: (...args: any[]) => void;
      dataLayer: any[];
    }
  }

  export default function AdvancedAnalytics() {
    const pathname = usePathname();
    const searchParams = useSearchParams();
    const [articleData, setArticleData] = useState<{
      isArticle: boolean;
      articleId?: string;
      articleTitle?: string;
      articleAuthor?: string;
      articleCategory?: string;
    } | null>(null);
    const lastTrackedPathRef = useRef<string>('');
    const sentArticleViewRef = useRef<Set<string>>(new Set());

    // Get GA Measurement ID based on hostname (from existing ScriptLoader.tsx)
    const getGAMeasurementId = () => {
      if (typeof window === 'undefined') return 'G-XXXXXXXXXX';

      const hostname = window.location.hostname;

      // Return appropriate GA4 ID based on hostname
      switch (hostname) {
        case 'argusenglish.in':
          return 'G-XXXXXXX'; // Production-2
        case 'uat.argusenglish.in':
          return 'G-XXXXXXX'; // UAT-2
        case 'argusnews.in':
          return 'G-XXXXXXXX'; // Production
        case 'uat.argusnews.in':
          return 'G-XXXXXXX'; // UAT
        default:
          return process.env.NEXT_PUBLIC_GA_MEASUREMENT_ID || 'G-XXXXXXXXXX'; // Fallback
      }
    };

    const GA_MEASUREMENT_ID = useMemo(() => getGAMeasurementId(), []);

    useEffect(() => {
      // GA4 is already initialized server-side in layout.tsx
      // Just ensure gtag function exists for tracking
      if (typeof window !== 'undefined' && !(window as any).gtag) {
        (window as any).dataLayer = (window as any).dataLayer || [];
        // eslint-disable-next-line @typescript-eslint/no-explicit-any
        (window as any).gtag = function(...args: any[]) {
          (window as any).dataLayer.push(args);
        };
      }
    }, []);

    useEffect(() => {
      let cancelled = false;
      const controller = new AbortController();

      const fetchArticleByPath = async () => {
        if (!pathname) {
          setArticleData({ isArticle: false });
          return;
        }

        const parts = pathname.split('/').filter(Boolean);
        // Expected article route: /[category]/[article]
        if (parts.length !== 2) {
          setArticleData({ isArticle: false });
          return;
        }

        const [categorySlug, articleSlug] = parts;
        try {
          const res = await fetch(`/api/${categorySlug}/${articleSlug}`, {
            method: 'GET',
            signal: controller.signal,
            cache: 'no-store',
          });

          if (!res.ok) {
            if (!cancelled) setArticleData({ isArticle: false });
            return;
          }

          const json = await res.json();
          const post = json?.data;
          if (!post || typeof post !== 'object') {
            if (!cancelled) setArticleData({ isArticle: false });
            return;
          }

          const categoryValue = Array.isArray(post.category)
            ? (post.category?.[0]?.slug || post.category?.[0]?.name || categorySlug)
            : (post.category || categorySlug);
          const authorValue = post.authors || post.author || 'Unknown';
          const titleValue = post.metaTitle || post.title || 'Unknown Title';

          if (!cancelled) {
            setArticleData({
              isArticle: true,
              articleId: String( articleSlug),
              articleTitle: String(titleValue).substring(0, 100),
              articleAuthor: String(authorValue).substring(0, 50),
              articleCategory: String(categoryValue),
            });
          }
        } catch {
          if (!cancelled) setArticleData({ isArticle: false });
        }
      };

      fetchArticleByPath();
      return () => {
        cancelled = true;
        controller.abort();
      };
    }, [pathname]);

    // Track page views
    useEffect(() => {
      if (typeof window === 'undefined' || !(window as any).gtag || !pathname) return;

      const params = searchParams?.toString();
      const pagePath = pathname + (params ? `?${params}` : '');
      if (lastTrackedPathRef.current === pagePath) return;
      lastTrackedPathRef.current = pagePath;

      (window as any).gtag('config', GA_MEASUREMENT_ID, {
        page_path: pagePath,
        page_title: document.title,
        send_page_view: false,
      });

      // Explicit GA4 page_view for SPA transitions.
      (window as any).gtag('event', 'page_view', {
        page_path: pagePath,
        page_title: document.title,
        page_location: window.location.href,
        article_id: articleData?.articleId,
        article_title: articleData?.articleTitle,
        article_author: articleData?.articleAuthor,
        article_category: articleData?.articleCategory,
      });
    }, [pathname, searchParams, GA_MEASUREMENT_ID]);

    useEffect(() => {
      if (typeof window === 'undefined' || !(window as any).gtag || !articleData?.isArticle || !pathname) return;
      const key = `${pathname}::${articleData.articleId || 'unknown'}`;
      if (sentArticleViewRef.current.has(key)) return;
      sentArticleViewRef.current.add(key);

      (window as any).gtag('event', 'article_view', {
        article_id: articleData.articleId,
        article_title: articleData.articleTitle,
        article_author: articleData.articleAuthor,
        article_category: articleData.articleCategory,
        page_path: pathname,
      });
    }, [articleData, pathname]);

    // Track user engagement events
    useEffect(() => {
      let timeoutId: number | null = null;
      const observers: IntersectionObserver[] = [];
      const videosWithHandlers: Array<{ el: Element; playHandler: EventListener; pauseHandler: EventListener }> = [];
      const searchInputsWithHandlers: Array<{ el: Element; handler: EventListener }> = [];

      let trackScroll: EventListener | null = null;
      let trackTimeOnPage: EventListener | null = null;
      let socialClickHandler: EventListener | null = null;
      let visibilityHandler: EventListener | null = null;

      const trackEngagement = () => {
        let maxScrollDepth = 0;

        trackScroll = () => {
          const scrollTop = window.pageYOffset || document.documentElement.scrollTop;
          const windowHeight = window.innerHeight;
          const documentHeight = document.documentElement.scrollHeight;
          const scrollDepth = Math.round(((scrollTop + windowHeight) / documentHeight) * 100);

          if (scrollDepth > maxScrollDepth && scrollDepth <= 100) {
            maxScrollDepth = scrollDepth;

            if ([25, 50, 75, 90].includes(scrollDepth)) {
              const eventData: any = {
                event_category: 'engagement',
                event_label: `${scrollDepth}%`,
                value: scrollDepth,
                custom_parameter_1: pathname,
              };

              if (articleData?.isArticle) {
                eventData.article_id = articleData.articleId;
                eventData.article_title = articleData.articleTitle;
                eventData.article_author = articleData.articleAuthor;
                eventData.article_category = articleData.articleCategory;
              }

              (window as any).gtag?.('event', 'scroll_depth', eventData);
            }
          }
        };

        let startTime = Date.now();
        trackTimeOnPage = () => {
          const timeSpent = Math.round((Date.now() - startTime) / 1000);
          if (timeSpent > 0 && timeSpent % 30 === 0) {
            const eventData: any = {
              event_category: 'engagement',
              event_label: `${timeSpent}s`,
              value: timeSpent,
              custom_parameter_1: pathname,
            };

            if (articleData?.isArticle) {
              eventData.article_id = articleData.articleId;
              eventData.article_title = articleData.articleTitle;
              eventData.article_author = articleData.articleAuthor;
              eventData.article_category = articleData.articleCategory;
            }

            (window as any).gtag?.('event', 'time_on_page', eventData);
          }
        };

        const articleContent = document.querySelector('[data-article-content]');
        if (articleContent) {
          const observer = new IntersectionObserver(
            (entries) => {
              entries.forEach((entry) => {
                if (entry.isIntersecting) {
                  const progress = Math.round(entry.intersectionRatio * 100);
                  if (progress >= 75) {
                    const eventData: any = {
                      event_category: 'engagement',
                      event_label: '75%_read',
                      custom_parameter_1: pathname,
                    };

                    if (articleData?.isArticle) {
                      eventData.article_id = articleData.articleId;
                      eventData.article_title = articleData.articleTitle;
                      eventData.article_author = articleData.articleAuthor;
                      eventData.article_category = articleData.articleCategory;
                    }

                    (window as any).gtag?.('event', 'article_read', eventData);
                  }
                }
              });
            },
            { threshold: [0.25, 0.5, 0.75, 1.0] }
          );

          observer.observe(articleContent);
          observers.push(observer);
        }

        const triggerViewItem = () => {
          if (articleData?.isArticle) {
            (window as any).gtag?.('event', 'view_item', {
              item_id: articleData.articleId || "",
              item_name: articleData.articleTitle,
              item_category: articleData.articleCategory || "",
              author_name: articleData.articleAuthor,
              page_path: pathname,
              page_location: window.location.href,
            });
          }
        };

        socialClickHandler = (e: Event) => {
          const target = e.target as HTMLElement;
          const socialLink = target?.closest && target.closest('[data-social-share]');

          if (socialLink) {
            const platform = (socialLink as Element).getAttribute('data-platform') || 'unknown';
            (window as any).gtag?.('event', 'social_share', {
              event_category: 'social',
              event_label: platform,
              custom_parameter_1: pathname,
            });
          }
        };

        const videos = document.querySelectorAll('video, iframe[src*="youtube"], iframe[src*="vimeo"]');
        videos.forEach((video, index) => {
          const playHandler = () => {
            (window as any).gtag?.('event', 'video_play', {
              event_category: 'video',
              event_label: `video_${index + 1}`,
              custom_parameter_1: pathname,
            });
          };
          const pauseHandler = () => {
            (window as any).gtag?.('event', 'video_pause', {
              event_category: 'video',
              event_label: `video_${index + 1}`,
              custom_parameter_1: pathname,
            });
          };

          video.addEventListener('play', playHandler);
          video.addEventListener('pause', pauseHandler);
          videosWithHandlers.push({ el: video, playHandler, pauseHandler });
        });

        const searchInputs = document.querySelectorAll('input[type="search"], input[placeholder*="search" i]');
        searchInputs.forEach((input) => {
          const handler = (e: Event) => {
            const target = e.target as HTMLInputElement;
            const query = target.value?.trim();
            if (query && query.length > 2) {
              (window as any).gtag?.('event', 'search', {
                event_category: 'search',
                event_label: query,
                search_term: query,
                custom_parameter_1: pathname,
              });
            }
          };
          input.addEventListener('blur', handler);
          searchInputsWithHandlers.push({ el: input, handler });
        });

        window.addEventListener('scroll', trackScroll as EventListener);
        window.addEventListener('beforeunload', trackTimeOnPage as EventListener);
        document.addEventListener('click', socialClickHandler as EventListener);

        triggerViewItem();

        visibilityHandler = () => {
          if (document.hidden) {
            (window as any).gtag?.('event', 'page_hidden', {
              event_category: 'engagement',
              custom_parameter_1: pathname,
            });
          } else {
            (window as any).gtag?.('event', 'page_visible', {
              event_category: 'engagement',
              custom_parameter_1: pathname,
            });
          }
        };
        document.addEventListener('visibilitychange', visibilityHandler);
      };

      // Delay tracking to ensure GA4 is loaded
      timeoutId = window.setTimeout(trackEngagement, 2000);

      return () => {
        if (timeoutId !== null) clearTimeout(timeoutId);
        if (trackScroll) window.removeEventListener('scroll', trackScroll);
        if (trackTimeOnPage) window.removeEventListener('beforeunload', trackTimeOnPage);
        if (socialClickHandler) document.removeEventListener('click', socialClickHandler);
        if (visibilityHandler) document.removeEventListener('visibilitychange', visibilityHandler);

        observers.forEach((o) => o.disconnect());
        videosWithHandlers.forEach(({ el, playHandler, pauseHandler }) => {
          el.removeEventListener('play', playHandler);
          el.removeEventListener('pause', pauseHandler);
        });
        searchInputsWithHandlers.forEach(({ el, handler }) => {
          el.removeEventListener('blur', handler);
        });
      };
    }, [pathname, articleData]);

    return null;
  }
